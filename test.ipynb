   "source": [
    "import librosa\n",
    "from IPython.display import Audio\n",
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"voxpopuli_with_mfcc.csv\")\n",
    "\n",
    "print(\"Sample audio playback:\")\n",
    "idx = 1350\n",
    "audio_path = df.loc[idx, \"audio_path\"]\n",
    "y, sr = librosa.load(audio_path, sr=None)\n",
    "display(Audio(y, rate=sr))\n",
    "\n"
   ]
  }
